{
  "name": "vlm-reader",
  "version": "0.5.1",
  "description": "VLMReader — 阅读、理解与记忆",
  "author": "VLMReader",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "pnpm build && electron-builder --win dir --x64 && node scripts/finalize_package.cjs",
    "installer": "python scripts/build_installer_msi.py"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/inter": "^5.2.8",
    "@xmldom/xmldom": "0.8.15",
    "dompurify": "^3.3.0",
    "epubjs": "^0.3.93",
    "jszip": "3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "marked": "^17.0.0",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sherpa-onnx-node": "1.13.8",
    "sql.js": "^1.13.0",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "study.memreader.desktop",
    "productName": "VLMReader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "asarUnpack": [
      "electron/tts-worker.cjs",
      "**/@breezystack/lamejs/**",
      "**/sherpa-onnx*/**",
      "**/*.node",
      "**/*.dll"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "npmRebuild": false
  }
}
